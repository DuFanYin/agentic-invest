# Required: LLM provider ("openrouter", "openai", or "deepseek")
# openrouter free model not recommendeded
LLM_PROVIDER=deepseek

# Required: API key for the selected provider
# - openrouter -> sk-or-v1-...
# - openai     -> sk-...
# - deepseek   -> sk-...  (from https://platform.deepseek.com/api_keys)
LLM_API_KEY=your_llm_api_key_here

# Optional: Tavily API key for web/news search
# If missing, web search degrades gracefully.
TAVILY_API_KEY=tvly-...


FRED_API_KEY=
